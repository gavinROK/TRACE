# NestJS's internal package loader (@nestjs/core) resolves sibling
# @nestjs/* packages (platform-express, schedule, config) with a plain
# `require()` relative to its own install location. npm's default
# hoisting can place @nestjs/core at the workspace root while leaving
# single-consumer packages like @nestjs/platform-express nested under
# apps/api/node_modules — two different node_modules trees, which
# breaks that resolution at runtime ("No driver (HTTP) has been
# selected") even though `tsc` and Jest (via Node's own multi-level
# resolution) don't notice. `nested` keeps each workspace's
# dependencies together in its own node_modules, matching how NestJS
# expects to find its own ecosystem packages.
install-strategy=nested
