# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
#
# Both are server-only — read exclusively by Route Handlers under
# app/api/, never by "use client" code, so the API key never reaches the
# browser bundle. Leave unset and the frontend falls back to its existing
# local demo data (see apps/web/lib/data.ts); nothing breaks either way.

TRACE_API_BASE_URL="http://localhost:4000"
TRACE_API_KEY=

# --- Infrastructure control plane (app/infra) ---
# Public on purpose: unlike TRACE_API_KEY above, there is no secret to
# protect here — the infra API's own cookie session (or WebAuthn/
# password login) is what authorizes a request, not this URL. The
# browser calls this origin directly with credentials: "include".
NEXT_PUBLIC_TRACE_API_BASE_URL="http://localhost:4000"
