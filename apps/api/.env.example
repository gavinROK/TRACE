# Copy to .env and adjust as needed. .env is gitignored — never commit it.

# Local development only. Matches docker-compose.yml at the repo root.
DATABASE_URL="postgresql://trace:trace_dev_password@localhost:5433/trace?schema=public"

PORT=4000

# --- GitHub App integration (Phase: GitHub integration) ---
# Leave unset to run TRACE without a real GitHub App; the GitHub module
# falls back to clearly-labeled mock data for local development instead of
# pretending to talk to the real API.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=

# --- Infrastructure control plane (apps/api/src/infra) ---

# Origin the frontend runs on — required for cross-origin cookie-based
# session auth (TraceAccessGuard) to work at all; CORS rejects wildcard
# origins once credentials: true is set.
TRACE_WEB_ORIGIN="http://localhost:3000"

# Base64, 32 bytes — e.g. `openssl rand -base64 32`. Encrypts every
# InfraCredential row (SSH passwords/keys, Proxmox tokens, SNMPv3 keys).
# On macOS, leave this UNSET: TRACE generates and stores the key in your
# login Keychain automatically on first run (see
# infra/credentials/master-key.store.ts). Only set this explicitly for
# CI/test, or on a non-macOS deployment where there is no Keychain.
# TRACE_MASTER_KEY=

# Shared secret the TRACE MCP server (packages/mcp-server) sends as a
# Bearer token to call the same API the browser UI uses. Generate with
# `openssl rand -base64 32`; put the same value in the MCP server's own
# config. Never share this with Claude itself — it lives only in the
# MCP server process's environment.
# TRACE_MCP_SERVICE_TOKEN=

# --- WebAuthn / YubiKey (only needed once you register a security key) ---
# TRACE_WEBAUTHN_RP_ID="localhost"
# TRACE_WEBAUTHN_RP_NAME="TRACE"
# TRACE_WEBAUTHN_ORIGIN="http://localhost:3000"

# How often enrolled devices are polled for health/metrics, in ms.
# TRACE_METRICS_POLL_INTERVAL_MS=300000
