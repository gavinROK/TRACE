# Copy to .env and adjust as needed. .env is gitignored — never commit it.

# Local development only. Matches docker-compose.yml at the repo root.
DATABASE_URL="postgresql://trace:trace_dev_password@localhost:5433/trace?schema=public"

PORT=4000

# --- GitHub App integration (Phase: GitHub integration) ---
# Leave unset to run TRACE without a real GitHub App; the GitHub module
# falls back to clearly-labeled mock data for local development instead of
# pretending to talk to the real API.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_WEBHOOK_SECRET=
